# MongoDB connection string — include the database name
MONGO_URI=mongodb://127.0.0.1:27017/devstack

# Port the Express server listens on
PORT=5000

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 64 characters. Never commit the real value.
JWT_SECRET=replace_with_64_char_random_hex_secret

# Frontend origin allowed by CORS — no trailing slash
FRONTEND_URL=http://localhost:5173
